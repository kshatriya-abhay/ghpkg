# Maintainer: Abhay Kshatriya
# Builds ghpkg's release package from this checkout. GitHub Actions runs it for
# every version tag and attaches the result to the release, where ghpkg-gh
# (packaging/ghpkg-gh) picks it up. By hand: cd packaging && makepkg

pkgname=ghpkg
pkgver=1.0.5
pkgrel=1
pkgdesc="Install apps from their GitHub releases as pacman packages, and keep them updated"
arch=(any)
url="https://github.com/kshatriya-abhay/ghpkg"
license=(MIT)
depends=(bash curl jq pacman pacman-contrib libarchive binutils fakeroot sudo coreutils util-linux)
optdepends=('github-cli: use your gh login for GitHub requests (5000 an hour instead of 60)')
install=ghpkg.install
options=(!debug)

package() {
  cd "$startdir/.."
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
