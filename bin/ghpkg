#!/bin/bash

# ghpkg: installs apps from their GitHub releases as pacman packages, and keeps
# them updated. For Arch Linux and Arch-based systems.

set -euo pipefail

# Installed, the code is in <prefix>/lib/ghpkg and the data in
# <prefix>/share/ghpkg. In the repo, both sit next to bin/.
_self=$(readlink -f "${BASH_SOURCE[0]}")
_prefix=${_self%/bin/*}
if [[ -f $_prefix/lib/ghpkg/common.sh ]]; then
  GHPKG_LIB=$_prefix/lib/ghpkg
  GHPKG_SHARE=$_prefix/share/ghpkg
else
  GHPKG_LIB=$_prefix/lib
  GHPKG_SHARE=$_prefix
fi
export GHPKG_SHARE

for _lib in "$GHPKG_LIB"/*.sh; do
  # shellcheck disable=SC1090
  source "$_lib"
done

usage() {
  cat <<'EOF'
Usage: ghpkg <command> [arguments]

Installs apps from their GitHub releases as pacman packages, and keeps them
updated. Each package is a PKGBUILD in ~/.config/pkgbuilds/<name>/.

Keeping packages updated:
  check-update          List every package and whether it can be updated. Changes nothing.
  update [package...]   Update to the latest release: edit the PKGBUILD, build, install.
  list                  List the packages, their versions and GitHub repos. Offline.
  remove <package>      Uninstall a package, and optionally delete its PKGBUILD.

Other:
  help [command]        Show help, for one command if given.
  --version             Show the version.

Run 'ghpkg help <command>' for details.
EOF
}

command_help() {
  case $1 in
    check-update) cat <<'EOF'
Usage: ghpkg check-update

Asks GitHub for each package's latest release and lists every package with
its state: up to date, can be updated, or not installed. Ends with a summary
line. Changes nothing. Exits 1 if a package couldn't be checked.
EOF
      ;;
    update) cat <<'EOF'
Usage: ghpkg update [package...]

For each package with a newer release: sets the PKGBUILD's pkgver, takes the
checksums from GitHub (or hashes the download when GitHub lists none), then
builds and installs it with makepkg -si. pacman asks before changing anything.

With no names it updates every installed package. Name a package that isn't
installed yet to install it. Needs a terminal, because sudo asks for a password.
EOF
      ;;
    list) cat <<'EOF'
Usage: ghpkg list

Lists every package with its installed version, its PKGBUILD's version and
its GitHub repo. Doesn't ask GitHub anything, so it works offline.
EOF
      ;;
    remove) cat <<'EOF'
Usage: ghpkg remove <package>

Uninstalls the package with pacman, then asks whether to delete its PKGBUILD
folder too. Keeps the folder unless you say yes.
EOF
      ;;
    *) usage ;;
  esac
}

cmd=${1:-}
(( $# )) && shift

case $cmd in
  '' | -h | --help) usage; exit 0 ;;
  help) command_help "${1:-}"; exit 0 ;;
  --version | version) echo "ghpkg $GHPKG_VERSION"; exit 0 ;;
esac

(( EUID != 0 )) || die "run ghpkg as your user, not root. It asks for sudo itself when installing."

case $cmd in
  check-update) require_system curl jq vercmp; check_update "$@" ;;
  update) require_system curl jq vercmp makepkg updpkgsums; update "$@" ;;
  list) require_system; list ;;
  remove) require_system; remove "$@" ;;
  *) warn "unknown command '$cmd'"; usage >&2; exit 1 ;;
esac
