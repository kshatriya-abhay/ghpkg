#!/bin/bash

# ghpkg: installs apps from their GitHub releases as pacman packages, and keeps
# them updated. For Arch Linux and Arch-based systems.

set -euo pipefail

# Installed, the code is in <prefix>/lib/ghpkg and the data in
# <prefix>/share/ghpkg. In the repo, both sit next to bin/.
_self=$(readlink -f "${BASH_SOURCE[0]}")
_prefix=${_self%/bin/*}
if [[ -f $_prefix/lib/ghpkg/common.sh ]]; then
  GHPKG_LIB=$_prefix/lib/ghpkg
  GHPKG_SHARE=$_prefix/share/ghpkg
else
  GHPKG_LIB=$_prefix/lib
  GHPKG_SHARE=$_prefix
fi
export GHPKG_SHARE

for _lib in "$GHPKG_LIB"/*.sh; do
  # shellcheck disable=SC1090
  source "$_lib"
done

usage() {
  cat <<'EOF'
Usage: ghpkg <command> [arguments]

Installs apps from their GitHub releases as pacman packages, and keeps them
updated. Each package is a PKGBUILD in ~/.config/pkgbuilds/<name>/.

Keeping packages updated:
  check-update          List every package and whether it can be updated. Changes nothing.
  update [package...]   Update to the latest release: edit the PKGBUILD, build, install.
  list                  List the packages, their versions and GitHub repos. Offline.
  remove <package>      Uninstall a package, and optionally delete its PKGBUILD.

Adding a package:
  add <owner/repo>      Add an app whose release has a .pkg.tar.zst, asking at each step.
  inspect <owner/repo>  Show what a release offers, and which package names are free.
  describe <owner/repo> <file>
                        Download a release file and show what's inside it.
  test-build <package>  Build a package without installing it, and compare it with upstream.
  skill install|remove  Make the ghpkg skill available to coding agents, for .deb releases.

Omarchy:
  hook install [--update]
                        After every omarchy update, list (or with --update, install) updates.

Other:
  help [command]        Show help, for one command if given.
  --version             Show the version.

Run 'ghpkg help <command>' for details.
EOF
}

command_help() {
  case $1 in
    check-update) cat <<'EOF'
Usage: ghpkg check-update

Asks GitHub for each package's latest release and lists every package with
its state: up to date, can be updated, or not installed. Ends with a summary
line. Changes nothing. Exits 1 if a package couldn't be checked.
EOF
      ;;
    update) cat <<'EOF'
Usage: ghpkg update [package...]

For each package with a newer release: sets the PKGBUILD's pkgver, takes the
checksums from GitHub (or hashes the download when GitHub lists none), then
builds and installs it with makepkg -si. pacman asks before changing anything.

With no names it updates every installed package. Name a package that isn't
installed yet to install it. Needs a terminal, because sudo asks for a password.
EOF
      ;;
    list) cat <<'EOF'
Usage: ghpkg list

Lists every package with its installed version, its PKGBUILD's version and
its GitHub repo. Doesn't ask GitHub anything, so it works offline.
EOF
      ;;
    remove) cat <<'EOF'
Usage: ghpkg remove <package>

Uninstalls the package with pacman, then asks whether to delete its PKGBUILD
folder too. Keeps the folder unless you say yes.
EOF
      ;;
    add) cat <<'EOF'
Usage: ghpkg add <owner/repo or GitHub URL> [--file <release file>] [--name <package>]

Adds an app whose latest release has a .pkg.tar.zst, asking you at each step:
which file to use, the package name, the dependencies, and whether to keep any
script that runs as root. Then writes the PKGBUILD, test-builds it, and offers
to install it.

For .deb releases, use a coding agent with the ghpkg skill (ghpkg skill install).
EOF
      ;;
    inspect) cat <<'EOF'
Usage: ghpkg inspect <owner/repo or GitHub URL> [--json]

Shows the latest release, its Linux x86_64 files ranked by how easy they are to
package, whether the official repos have the app, which names are taken on the
AUR, and whether you already have a PKGBUILD for it. Changes nothing.
EOF
      ;;
    describe) cat <<'EOF'
Usage: ghpkg describe <owner/repo or GitHub URL> <release file> [--json]

Downloads a .pkg.tar.zst or .deb from the latest release into the cache,
checks it against GitHub's checksum, and shows what's inside: metadata,
dependencies, scripts that run as root, the files, the libraries the programs
link to and which packages own them, the AUR packages that are this same app
(for conflicts=), and anything that needs a decision, such as dependencies the
official repos don't have. Runs nothing from the package.
EOF
      ;;
    test-build) cat <<'EOF'
Usage: ghpkg test-build <package>

Builds the package in the cache without installing it or checking its
dependencies, then shows the result and compares its files, and their
permissions, with the release file it came from. Also checks that each
download link in source= is a file of the latest release: a wrong link can
build from the cache but would fail at the next update. Exits 1 if one isn't.
EOF
      ;;
    skill) cat <<'EOF'
Usage: ghpkg skill install | remove | path

install  Links the ghpkg skill into ~/.claude/skills, ~/.codex/skills and
         ~/.agents/skills, for the ones that exist.
remove   Removes those links.
path     Prints where the skill's files are.
EOF
      ;;
    hook) cat <<'EOF'
Usage: ghpkg hook install [--update] | remove | status

On Omarchy, runs ghpkg at the end of every `omarchy update`:
install           list the packages that can be updated (it never installs)
install --update  install the updates too; pacman still asks before changing anything
remove            take the hook out again
status            show which hook is installed
EOF
      ;;
    *) usage ;;
  esac
}

cmd=${1:-}
(( $# )) && shift

case $cmd in
  '' | -h | --help) usage; exit 0 ;;
  help) command_help "${1:-}"; exit 0 ;;
  --version | version) echo "ghpkg $GHPKG_VERSION"; exit 0 ;;
esac

(( EUID != 0 )) || die "run ghpkg as your user, not root. It asks for sudo itself when installing."

case $cmd in
  check-update) require_system curl jq vercmp; check_update "$@" ;;
  update) require_system curl jq vercmp makepkg updpkgsums; update "$@" ;;
  list) require_system; list ;;
  remove) require_system; remove "$@" ;;
  add) require_system curl jq vercmp makepkg fakeroot bsdtar readelf sha256sum; ensure_root; add "$@" ;;
  inspect) require_system curl jq; inspect "$@" ;;
  describe) require_system curl jq bsdtar readelf sha256sum; describe "$@" ;;
  test-build) require_system makepkg fakeroot bsdtar; test_build "$@" ;;
  skill) skill "$@" ;;
  hook) hook "$@" ;;
  *) warn "unknown command '$cmd'"; usage >&2; exit 1 ;;
esac
