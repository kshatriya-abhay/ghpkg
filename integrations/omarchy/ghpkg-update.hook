#!/bin/bash

# Installs new GitHub releases of your ghpkg packages at the end of every
# `omarchy update`. pacman still asks before changing anything.
# Installed with `ghpkg hook install --update`; `ghpkg hook install` swaps it
# for the report-only hook.

command -v ghpkg >/dev/null || exit 0

echo -e "\e[32m\nUpdate GitHub packages\e[0m"
ghpkg update
echo
