#!/bin/bash

# Lists new GitHub releases of your ghpkg packages at the end of every
# `omarchy update`. It only reports: install them with `ghpkg update`.
# Installed with `ghpkg hook install`; `ghpkg hook install --update` swaps it
# for the hook that installs them too.

command -v ghpkg >/dev/null || exit 0

echo -e "\e[32m\nCheck GitHub packages\e[0m"
ghpkg check-update
echo
